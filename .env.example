# 将棋大会ナビ — 環境変数の見本
# このファイルをコピーして「.env.local」を作り、値を入れてください。
# .env.local は git に入りません（秘密が漏れないように）。

# --- Supabase（共有プロジェクト・スキーマは shogi_taikai_navi）---
# 画面表示用（公開鍵。ブラウザに配られる。保護は RLS で行う）
NEXT_PUBLIC_SUPABASE_URL=https://eqkaaohdbqefuszxwqzr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ここに anon key を入れる

# 書き込み用（毎朝の自動更新だけが使う秘密の鍵。絶対に git に入れない）
SUPABASE_SERVICE_ROLE_KEY=ここに service_role key を入れる

# 自動更新APIのいたずら防止の合言葉（Vercel Cron 用。好きな長い文字列）
CRON_SECRET=ここに長いランダムな文字列を入れる
